rules_version = '2';

/**
 * قواعد أمان Cloud Firestore لتطبيق المصحف الصوتي
 * Quran Voice PWA - Production Security Rules
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. بيانات المستخدمين (جلسة الاستماع، آخر موضع، إحصائيات الوقت)
    // يُسمح بإنشاء وقراءة وتحديث بيانات المستمع تلقائياً دون إعاقة التجربة
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. سجل الأوامر الصوتية (Voice Logs & Telemetry)
    // يُسمح للزوار بإنشاء سجلات الأوامر الصوتية لتحسين دقة اللهجات، وللأدمن بالاستعلام عنها
    match /voice_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // 3. تنبيهات وإعلانات النظام الصوتي المباشر واستطلاعات الرأي
    match /system_config/{configDoc} {
      allow read: if true;
      allow write: if true;
    }

    // 4. استجابات وتصويتات استطلاعات الرأي السريعة (Micro-Surveys)
    match /survey_responses/{responseId} {
      allow read, write: if true;
    }

    // 5. حظر الوصول الافتراضي لأي مسارات أخرى غير معرفة
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
